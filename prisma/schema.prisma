

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String   @id @default(uuid())
  ex             String
  image          String
  title          Json
  shortDesc      Json
  applications   Json
  specifications Json
  createdAt      DateTime @default(now())
  additionalImages String[] @default([])
  isHidden  Boolean  @default(false)
  order     Int      @default(0)
}

model System {
  id               String   @id @default(uuid())
  slug             String   @unique
  ex               String
  image            String
  title            Json
  shortDesc        Json
  applications     Json    
  specifications   Json
  additionalImages String[] @default([])
  createdAt        DateTime @default(now())
  isHidden         Boolean  @default(false)
  order            Int      @default(0)

}

model Document {
  id        String   @id @default(uuid())
  category  String   // "certificate", "manual", "catalog"
  file      String   // Имя файла (например, manual.pdf)
  size      String   // Размер (например, "1.4 Мб")
  title     Json     // Названия на 3 языках {ru, en, cn}
  isHidden  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
