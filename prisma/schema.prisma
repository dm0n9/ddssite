

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(uuid())
  ex             String
  image          String
  title          Json
  shortDesc      Json
  applications   Json
  specifications Json
  createdAt      DateTime @default(now())
  additionalImages String[] @default([])
  isHidden  Boolean  @default(false)
}
